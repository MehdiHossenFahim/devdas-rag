# Copy this file to `.env` and fill in the values.

# Free key (no credit card): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Wikimedia asks scrapers to identify themselves - put your real e-mail here.
USER_AGENT=DevdasRAGStudentProject/1.0 (educational RAG assignment; contact: you@example.com)

# ---- optional overrides (defaults shown) ----
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=low          # low | medium | high
# EMBEDDING_MODEL=BAAI/bge-m3        # lighter alternative: intfloat/multilingual-e5-base
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
# TOP_K=5
# REQUEST_DELAY=2.0                  # seconds between Wikisource requests (raise if you get 429s)
